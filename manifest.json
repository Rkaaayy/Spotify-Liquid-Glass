{
  "manifest_version": 3,
  "name": "Liquid Glass for Spotify",
  "short_name": "Liquid Glass",
  "version": "1.1.1",
  "description": "iOS 28 Liquid Glass GUI for the Spotify web player \u2014 live refraction, chromatic edge split and frosted depth, fully themeable and responsive.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Liquid Glass for Spotify",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://open.spotify.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://open.spotify.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "110"
}